NODE_ENV=development
DATABASE_URL=postgresql://testgen:testgen_dev_password@localhost:5433/testgen_platform
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-refresh-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=平台管理员
BOOTSTRAP_ADMIN_ORGANIZATION_NAME=默认组织
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:5173/api/v1/auth/feishu/callback
QUEUE_PROVIDER=bullmq
STORAGE_PROVIDER=local

# LLM (OpenAI 兼容接口，Worker 处理任务时使用)
# 设置 OPENAI_API_KEY 后，Agent Worker 自动使用真实 LLM；未设置则回退到 Mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
